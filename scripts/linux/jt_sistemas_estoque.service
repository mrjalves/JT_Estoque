[Unit]
Description=JT Sistemas - Estoque Web Application (.NET 10)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/jt_estoque
ExecStart=/usr/bin/dotnet /var/www/jt_estoque/JT_Estoque.Web.dll
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=jt_sistemas_estoque

# Variáveis de ambiente da aplicação
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false
Environment=ASPNETCORE_URLS=http://127.0.0.1:5042

[Install]
WantedBy=multi-user.target
