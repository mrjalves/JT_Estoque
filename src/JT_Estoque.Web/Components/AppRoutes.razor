@using Microsoft.AspNetCore.Components.Authorization
@using JT_UserInterface.Shared.Layout
@using JT_UserInterface.Shared.Components.Comum

<CascadingAuthenticationState>
    <Router AppAssembly="typeof(Program).Assembly"
            AdditionalAssemblies="new[] { typeof(MainLayout).Assembly }">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
                <NotAuthorized>
                    <RedirectToLogin />
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
        <NotFound>
            <LayoutView Layout="typeof(MainLayout)">
                <div class="container py-5 text-center">
                    <div class="card p-5 shadow-sm border-0 mx-auto" style="max-width: 500px; border-radius: 1rem;">
                        <i class="bi bi-compass text-primary display-1 mb-3"></i>
                        <h2 class="fw-bold mb-2">404 - Página Não Encontrada</h2>
                        <p class="text-muted mb-4">A página requisitada não existe ou mudou de endereço no sistema de estoque.</p>
                        <a href="/estoque/dashboard" class="btn btn-primary btn-lg rounded-pill px-4">
                            <i class="bi bi-house-door me-2"></i>Ir para o Dashboard
                        </a>
                    </div>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
