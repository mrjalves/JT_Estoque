@using JT_Estoque.Core.Entities
@using JT_Estoque.Core.Services
@using JT_UserInterface.Shared.Components.Core
@using static JT_UserInterface.Shared.Components.Core.Modal
@inject InventarioEstoqueService InventarioService
@inject LocalEstoqueService LocalService

<Modal @ref="modalRef" 
       Title="Abrir Nova Sessão de Inventário Físico" 
       Size="ModalSize.Default"
       EntidadeContexto="@Inventario"
       EnableIA="true"
       NomeEntidade="InventarioEstoque"
       CanManageCustomFields="true"
       CloseOnBackdropClick="false">
    <BodyContent>
        <EditForm Model="this" OnValidSubmit="CriarSessao">
            <DataAnnotationsValidator />

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Código da Sessão <span class="text-danger">*</span></label>
                    <InputText class="form-control fw-bold" placeholder="ex: INV-2026-01" @bind-Value="codigo" required />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Almoxarifado a Auditar <span class="text-danger">*</span></label>
                    <InputSelect class="form-select" @bind-Value="localId">
                        <option value="0">Selecione o almoxarifado...</option>
                        @foreach (var l in locais)
                        {
                            <option value="@l.Id">@l.Nome (@l.Codigo)</option>
                        }
                    </InputSelect>
                </div>

                <div class="col-12">
                    <label class="form-label fw-semibold">Observações / Objetivo do Inventário</label>
                    <InputTextArea class="form-control" rows="3" placeholder="ex: Inventário geral de fechamento trimestral..." @bind-Value="observacao" />
                </div>

                <div class="col-12">
                    <div class="alert alert-info py-2 small mb-0">
                        <i class="bi bi-info-circle me-1"></i>
                        Ao abrir a sessão, o sistema capturará automaticamente uma fotografia do saldo atual de todos os produtos do catálogo para comparação cega com a contagem física.
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(mensagemErro))
            {
                <div class="alert alert-danger mt-3 py-2">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@mensagemErro
                </div>
            }

            <hr class="my-3" />
            <div class="d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-secondary" @onclick="Fechar">Cancelar</button>
                <button type="submit" class="btn btn-primary" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        <span>Congelando Saldo...</span>
                    }
                    else
                    {
                        <i class="bi bi-play-circle-fill me-1"></i>
                        <span>Iniciar Contagem</span>
                    }
                </button>
            </div>
        </EditForm>
    </BodyContent>
</Modal>

@code {
    private Modal? modalRef;
    private bool isSaving = false;
    private string? mensagemErro;

    private string codigo = string.Empty;
    private int localId = 0;
    private string observacao = string.Empty;
    private List<LocalEstoque> locais = [];

    [Parameter] public InventarioEstoque Inventario { get; set; } = new();
    [Parameter] public EventCallback OnSaved { get; set; }

    public async Task Abrir()
    {
        Inventario = new InventarioEstoque();
        codigo = $"INV-{DateTime.Now:yyyyMMdd-HHmm}";
        observacao = string.Empty;
        mensagemErro = null;
        isSaving = false;

        try
        {
            locais = await LocalService.GetAll();
            if (locais.Any()) localId = locais.First().Id;
        }
        catch { }

        modalRef?.Open();
        StateHasChanged();
    }

    public void Fechar()
    {
        modalRef?.Close();
    }

    private async Task CriarSessao()
    {
        if (string.IsNullOrWhiteSpace(codigo))
        {
            mensagemErro = "Informe o código da sessão de inventário.";
            return;
        }

        if (localId <= 0)
        {
            mensagemErro = "Selecione o almoxarifado.";
            return;
        }

        try
        {
            isSaving = true;
            mensagemErro = null;
            await InventarioService.AbrirSessaoInventarioAsync(localId, codigo, observacao);
            Fechar();
            await OnSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            mensagemErro = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }
}
