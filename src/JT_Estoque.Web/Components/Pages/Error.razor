@page "/Error"
@using System.Diagnostics

<PageTitle>Erro - JTech Estoque</PageTitle>

<div class="container py-5 text-center">
    <div class="card p-5 shadow-sm border-0 mx-auto" style="max-width: 600px; border-radius: 1rem;">
        <i class="bi bi-exclamation-triangle text-danger display-1 mb-3"></i>
        <h1 class="text-danger fw-bold fs-2 mb-2">Ops! Ocorreu um erro.</h1>
        <p class="text-muted mb-4">Ocorreu uma falha inesperada ao processar sua requisição no sistema de estoque.</p>

        @if (ShowRequestId)
        {
            <div class="alert alert-light border small text-start mb-4">
                <strong>ID da Requisição:</strong> <code>@RequestId</code>
            </div>
        }

        <div>
            <a href="/estoque/dashboard" class="btn btn-primary rounded-pill px-4 me-2">
                <i class="bi bi-house-door me-1"></i> Ir para o Dashboard
            </a>
            <button class="btn btn-outline-secondary rounded-pill px-4" onclick="location.reload()">
                <i class="bi bi-arrow-clockwise me-1"></i> Recarregar
            </button>
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
