@page "/estoque/inventarios"
@using JT_Estoque.Core.Entities
@using JT_Estoque.Core.Enums
@using JT_Estoque.Core.Services
@using JT_UserInterface.Shared.Components.Core
@using JT_UserInterface.Shared.Templates
@using static JT_UserInterface.Shared.Components.Core.Modal
@inject InventarioEstoqueService InventarioService
@inject LocalEstoqueService LocalService
@inject ProdutoEstoqueService ProdutoService

<CrudPageTemplate PageTitle="Inventário Físico & Auditoria de Estoque" PageIcon="bi-clipboard-check">
    <PageDescription>
        Abertura de sessões de contagem cega, apuração de divergências entre físico e sistema e homologação com geração automática de ajustes no Kardex.
    </PageDescription>

    <ToolbarLeft>
        <button class="btn btn-primary shadow-sm" @onclick="() => modalInventarioRef?.Abrir()">
            <i class="bi bi-plus-circle-fill me-1"></i>
            <span>Nova Sessão de Inventário</span>
        </button>
    </ToolbarLeft>

    <ToolbarRight>
    </ToolbarRight>

    <ChildContent>
        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status"></div>
                <div class="mt-2 text-muted">Carregando sessões de inventário...</div>
            </div>
        }
        else if (!inventarios.Any())
        {
            <div class="card p-5 text-center border-0 shadow-sm">
                <i class="bi bi-clipboard-x display-3 text-muted mb-3"></i>
                <h5 class="fw-bold">Nenhuma sessão de inventário</h5>
                <p class="text-muted">Inicie uma sessão de inventário físico para auditar os estoques dos almoxarifados.</p>
                <div class="mt-2">
                    <button class="btn btn-primary" @onclick="() => modalInventarioRef?.Abrir()">
                        <i class="bi bi-play-circle-fill me-1"></i>Abrir Primeira Sessão
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="card card-modern overflow-hidden">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Código da Sessão</th>
                                <th>Almoxarifado</th>
                                <th>Data de Abertura</th>
                                <th>Data de Fechamento</th>
                                <th class="text-center">Status</th>
                                <th>Observações</th>
                                <th class="text-end">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var inv in inventarios.OrderByDescending(i => i.DataAbertura))
                            {
                                var loc = locais.FirstOrDefault(l => l.Id == inv.LocalEstoqueId);
                                <tr>
                                    <td>
                                        <div class="fw-bold font-monospace text-primary">@inv.Codigo</div>
                                    </td>
                                    <td>
                                        <div>@(loc?.Nome ?? $"Local #{inv.LocalEstoqueId}")</div>
                                    </td>
                                    <td class="small text-muted font-monospace">
                                        @inv.DataAbertura.ToString("dd/MM/yyyy HH:mm")
                                    </td>
                                    <td class="small text-muted font-monospace">
                                        @(inv.DataFechamento?.ToString("dd/MM/yyyy HH:mm") ?? "-")
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @ObterBadgeStatus(inv.Status)">
                                            @inv.Status
                                        </span>
                                    </td>
                                    <td class="small text-muted" style="max-width: 250px;">
                                        @inv.Observacoes
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <button class="btn btn-outline-primary" title="Contagem / Apurar Itens" @onclick="() => AbrirModalItens(inv)">
                                                <i class="bi bi-card-checklist me-1"></i>
                                                <span>Contagem</span>
                                            </button>

                                            @if (inv.Status != eStatusInventario.Processado && inv.Status != eStatusInventario.Cancelado)
                                            {
                                                <button class="btn btn-outline-success" title="Processar e Gerar Ajustes no Kardex" @onclick="() => SolicitarHomologacao(inv)">
                                                    <i class="bi bi-check-all me-1"></i>
                                                    <span>Homologar</span>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </ChildContent>

    <Modals>
        <ModalInventario @ref="modalInventarioRef" OnSaved="CarregarInventariosAsync" />

        <!-- MODAL DE DIGITAÇÃO DE CONTAGEM E APURAÇÃO DE ITENS -->
        <Modal @ref="modalItensRef" Title="@($"Contagem de Inventário: {inventarioSelecionado?.Codigo}")" Size="ModalSize.ExtraLarge">
            <BodyContent>
                @if (inventarioSelecionado != null)
                {
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="small text-muted">
                            <span class="me-3"><i class="bi bi-building me-1"></i>Almoxarifado: <strong>@(locais.FirstOrDefault(l => l.Id == inventarioSelecionado.LocalEstoqueId)?.Nome)</strong></span>
                            <span><i class="bi bi-clock me-1"></i>Aberto em: <strong>@inventarioSelecionado.DataAbertura.ToString("dd/MM/yyyy HH:mm")</strong></span>
                        </div>
                        <div>
                            <span class="badge @ObterBadgeStatus(inventarioSelecionado.Status)">@inventarioSelecionado.Status</span>
                        </div>
                    </div>

                    @if (isLoadingItens)
                    {
                        <div class="text-center py-4"><div class="spinner-border spinner-border-sm text-primary"></div></div>
                    }
                    else if (!itensInventario.Any())
                    {
                        <div class="alert alert-warning py-2 small">Nenhum produto foi capturado para esta sessão.</div>
                    }
                    else
                    {
                        <div class="table-responsive" style="max-height: 450px; overflow-y: auto;">
                            <table class="table table-sm table-hover align-middle mb-0">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th>Produto</th>
                                        <th class="text-center">Qtd. Sistema</th>
                                        <th class="text-center" style="width: 160px;">Qtd. Contada</th>
                                        <th class="text-center">Divergência</th>
                                        <th class="text-end" style="width: 100px;">Ação</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in itensInventario)
                                    {
                                        var prod = produtos.FirstOrDefault(p => p.Id == item.ProdutoId);
                                        decimal divergencia = item.QuantidadeContada - item.QuantidadeSistema;

                                        <tr>
                                            <td>
                                                <div class="fw-semibold">@(prod?.Nome ?? $"ID {item.ProdutoId}")</div>
                                                <small class="text-muted font-monospace">@(prod?.CodigoSKU ?? "")</small>
                                            </td>
                                            <td class="text-center fw-semibold text-muted">
                                                @item.QuantidadeSistema.ToString("N2")
                                            </td>
                                            <td class="text-center">
                                                @if (inventarioSelecionado.Status != eStatusInventario.Processado)
                                                {
                                                    <input type="number" step="0.01" class="form-control form-control-sm text-center fw-bold"
                                                           value="@item.QuantidadeContada"
                                                           @onchange="@(async (ChangeEventArgs e) => await SalvarItemContado(item, e.Value?.ToString()))" />
                                                }
                                                else
                                                {
                                                    <span class="fw-bold">@item.QuantidadeContada.ToString("N2")</span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                @if (divergencia == 0)
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle">0.00 (Exato)</span>
                                                }
                                                else if (divergencia > 0)
                                                {
                                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">+@divergencia.ToString("N2") (Sobra)</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">@divergencia.ToString("N2") (Falta)</span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                @if (inventarioSelecionado.Status != eStatusInventario.Processado)
                                                {
                                                    <button class="btn btn-sm btn-outline-secondary" title="Igualar ao Sistema" @onclick="() => IgualarAoSaldoSistema(item)">
                                                        <i class="bi bi-arrow-repeat"></i>
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
            </BodyContent>
            <FooterContent>
                <button type="button" class="btn btn-secondary" @onclick="() => modalItensRef?.Close()">Fechar</button>
            </FooterContent>
        </Modal>

        <ConfirmDialog @ref="confirmHomologarDialog" OnConfirm="EfetuarHomologacao" />
    </Modals>
</CrudPageTemplate>

@code {
    private bool isLoading = true;
    private bool isLoadingItens = false;

    private List<InventarioEstoque> inventarios = [];
    private List<LocalEstoque> locais = [];
    private List<ProdutoEstoque> produtos = [];
    private List<InventarioItem> itensInventario = [];

    private InventarioEstoque? inventarioSelecionado;
    private InventarioEstoque? inventarioParaHomologar;

    private ModalInventario? modalInventarioRef;
    private Modal? modalItensRef;
    private ConfirmDialog? confirmHomologarDialog;

    protected override async Task OnInitializedAsync()
    {
        await CarregarInventariosAsync();
    }

    private async Task CarregarInventariosAsync()
    {
        try
        {
            isLoading = true;
            inventarios = await InventarioService.GetAll();
            locais = await LocalService.GetAll();
            produtos = await ProdutoService.GetAll();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar inventários: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task AbrirModalItens(InventarioEstoque inv)
    {
        inventarioSelecionado = inv;
        modalItensRef?.Open();

        try
        {
            isLoadingItens = true;
            itensInventario = await InventarioService.ObterItensInventarioAsync(inv.Id);
        }
        finally
        {
            isLoadingItens = false;
            StateHasChanged();
        }
    }

    private async Task SalvarItemContado(InventarioItem item, string? valorStr)
    {
        if (decimal.TryParse(valorStr, out decimal valor))
        {
            item.QuantidadeContada = valor;
            await InventarioService.AtualizarItemInventarioAsync(item);
        }
    }

    private async Task IgualarAoSaldoSistema(InventarioItem item)
    {
        item.QuantidadeContada = item.QuantidadeSistema;
        await InventarioService.AtualizarItemInventarioAsync(item);
    }

    private void SolicitarHomologacao(InventarioEstoque inv)
    {
        inventarioParaHomologar = inv;
        confirmHomologarDialog?.Show(
            "Homologar e Fechar Sessão de Inventário",
            $"Deseja fechar a sessão '{inv.Codigo}' e gerar automaticamente os lançamentos de ajuste positivo/negativo no Kardex para todos os itens divergentes?",
            "Homologar e Ajustar Saldo",
            "Cancelar"
        );
    }

    private async Task EfetuarHomologacao()
    {
        if (inventarioParaHomologar != null)
        {
            await InventarioService.ProcessarInventarioAsync(inventarioParaHomologar.Id);
            inventarioParaHomologar = null;
            await CarregarInventariosAsync();
        }
    }

    private string ObterBadgeStatus(eStatusInventario status) => status switch
    {
        eStatusInventario.Aberto => "bg-primary-subtle text-primary border border-primary-subtle",
        eStatusInventario.EmContagem => "bg-warning-subtle text-warning border border-warning-subtle",
        eStatusInventario.Processado => "bg-success-subtle text-success border border-success-subtle",
        eStatusInventario.Cancelado => "bg-secondary-subtle text-secondary border",
        _ => "bg-light text-dark"
    };
}
